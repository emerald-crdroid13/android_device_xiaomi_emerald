<resources>
    <!-- Doze holds the display in the panel's DOZE power state instead of turning it off. Needed for the
         always-on display (with config_dozeAlwaysOnDisplayAvailable in FrameworksResOverlayEmerald) and
         for any ambient display that has to stay lit. Tested in the LineageOS line on 2026-10-20: the
         phone stayed in AOD with this pair of flags. DozeParameters also takes the sysprop
         doze.display.supported, which can flip this on the phone without a build. -->
    <bool name="doze_display_state_supported">true</bool>
</resources>
