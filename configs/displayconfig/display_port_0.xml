<!-- Named by port, not by display id, so it applies to both emerald panels.

     This is the stock map from OS3.0.307.0 product/etc/displayconfig/display_id_4627039422300187648.xml
     plus the block that lets the framework enter high brightness mode.

     Scale: the stock lights HAL takes 12-bit backlight levels (LightsService sends 1..4095 since the
     "LightsService: Send a 12-bit backlight level" patch) and that level is the panel's DBV, linear
     with nits: the stock minimum DBV 8 is the 2 nits point, PanelMaxDbv 2047 (the end of the
     factory range, AAL logs "phy:2047/4095" at the slider maximum) is 500 nits, and the HBM half of
     the range ends at DBV 4095 = 1000 nits. Brightness values are absolute on that same scale, which
     is why the settings minimum 1/254 = level 17 sits just above MiBrightness MinDBV=16, and the
     default 0.15 = level 615 (about 150 nits) is the HyperOS default.

     Until now the map stopped at 500 nits and there was no <highBrightnessMode>, so the framework
     capped brightness at 500 nits and the HBM half of the range was unreachable (hbmMode=off in
     every log since C1.0, flashlight test of 18.11: 43 420 lux, brt=1.0, nits=500). With the block
     below the cap is transitionPoint while the ambient light is dim and 1.0 (1000 nits) from
     6001 lux up, which is how the stock ROM reaches 1000 nits. The auto brightness curve in
     FrameworksResOverlayEmerald is already in nits and was resampled from the stock one, so it keeps
     giving the same brightness below 500 nits and climbs to ~826 nits at 45 000 lux.

     Differences from the stock file: thermalStatusLimit is dropped, this framework version has no
     such field (unknown elements are skipped; HBM is limited by the normal brightness throttling
     instead). The timing limits are not the stock zeros: the stock ROM leaves HBM timing to the
     vendor service (hbmKeepOnMaxTime 1800 s, hbmRestTime 600 s), and that path is dead here (it
     writes /sys/class/mi_display/disp-DSI-0/backlight, an attribute this kernel does not have), so
     the framework enforces its own budget: at most 1800 s of HBM per hour, half the vendor duty
     cycle. The thermalThrottling block caps brightness by thermal status, which also drops HBM: a
     cap at the transition point means "no HBM", since the controller only keeps HBM while the
     brightness is above it. Horizon values as stock. -->
<displayConfiguration>
    <screenBrightnessMap>
        <point>
            <value>0.001709819</value>
            <nits>2.0</nits>
        </point>
        <point>
            <value>0.49975574</value>
            <nits>500.0</nits>
        </point>
        <point>
            <value>1.0</value>
            <nits>1000.0</nits>
        </point>
    </screenBrightnessMap>
    <thermalThrottling>
        <brightnessThrottlingMap>
            <brightnessThrottlingPoint>
                <thermalStatus>severe</thermalStatus>
                <brightness>0.49975574</brightness>
            </brightnessThrottlingPoint>
            <brightnessThrottlingPoint>
                <thermalStatus>critical</thermalStatus>
                <brightness>0.3</brightness>
            </brightnessThrottlingPoint>
        </brightnessThrottlingMap>
    </thermalThrottling>
    <highBrightnessMode enabled="true">
        <transitionPoint>0.49975574</transitionPoint>
        <minimumLux>6001</minimumLux>
        <timing>
            <timeWindowSecs>3600</timeWindowSecs>
            <timeMaxSecs>1800</timeMaxSecs>
            <timeMinSecs>60</timeMinSecs>
        </timing>
        <allowInLowPowerMode>true</allowInLowPowerMode>
        <minimumHdrPercentOfScreen>0</minimumHdrPercentOfScreen>
        <sdrHdrRatioMap>
            <point>
                <sdrNits>2.0</sdrNits>
                <hdrRatio>1</hdrRatio>
            </point>
            <point>
                <sdrNits>1000.0</sdrNits>
                <hdrRatio>1</hdrRatio>
            </point>
        </sdrHdrRatioMap>
    </highBrightnessMode>
    <ambientLightHorizonLong>3000</ambientLightHorizonLong>
    <ambientLightHorizonShort>1000</ambientLightHorizonShort>
</displayConfiguration>
