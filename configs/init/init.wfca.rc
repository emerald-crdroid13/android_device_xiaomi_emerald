# Stock OS3.0.307.0 /vendor/etc/init/init.wfca.rc, with "service wfca" commented out:
# the service is never needed on the crDroid line and stays off, so the block cannot be
# started by anything. Everything else is the stock file, byte for byte.
#
## WFCA related services (Begin)
#

# service wfca /vendor/bin/wfca
#     class core
#     socket wfca stream 660 system system
#     socket wfca_rds stream 660 system system
#     user system
#     group system log inet radio net_raw net_admin
#     capabilities NET_RAW NET_ADMIN

#
## WFCA related services (End)
#

