# Stock OS3.0.307.0 /vendor/etc/init/init.frs.rc: the 'start frs' line is commented out, the
# service stays off - nothing on the crDroid line needs it (device/xiaomi/emerald
# patch-images.py). Everything else is the stock file, byte for byte.
service frs /vendor/bin/frs
    class main
    socket frs_socket stream 660 root system
    user root
    group system
    disabled

on property:sys.boot_completed=1
#     start frs
